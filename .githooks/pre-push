#!/usr/bin/env bash
# pre-push: run the Test gate over the outgoing range. Silent on green; on a
# red range print the suite's single relevant line + the bypass note and stop.
# Local guardrail, not a server gate — bypass with `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0
out=$(tests/validate.sh origin/main..HEAD 2>&1); code=$?
[ "$code" -eq 0 ] && exit 0
grep -m1 '^FAIL:' <<<"$out" || echo "pre-push: tests/validate.sh origin/main..HEAD failed"
echo "pre-push blocked (red range). Bypass: git push --no-verify"
exit 1
